      "description": "Gérer vos propriétés",
      "url": "/properties",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96" }]
    }
  ],

  "prefer_related_applications": false,
  "related_applications": [],

  "protocol_handlers": [],

  "file_handlers": [],

  "share_target": {
    "action": "/messages",
