      "description": "Ouvrir l'inbox unifiée",
      "url": "/messages",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Réservations",
      "short_name": "Réservations",
      "description": "Voir les réservations en cours",
      "url": "/reservations",
      "icons": [{ "src": "/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Propriétés",
